{
    "name": "erikwestlund/phpolars-phibble",
    "description": "A Polars-backed Phibble\\Contracts\\Table: phibble and phplyr verbs running in Polars",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-php_polars": "*",
        "erikwestlund/phibble": "^0.1"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Phpolars\\Phibble\\": "src/"
        }
    },
    "repositories": [
        {"type": "vcs", "url": "https://github.com/erikwestlund/phibble"}
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
